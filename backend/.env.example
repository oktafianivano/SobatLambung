# =========================================================================
# Template environment backend.
# Salin menjadi backend/.env lalu isi nilainya.
# Untuk production WAJIB: APP_ENV=production dan HTTPS.
# =========================================================================

# === Application ===
# development | testing | production
APP_ENV=production

# === Security / JWT ===
# Gunakan string acak panjang (minimal 32 karakter):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=isi_dengan_string_acak_panjang_minimal_32_karakter
ALGORITHM=HS256

# Access token singkat; diperbarui otomatis lewat refresh token.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token sliding window. Setiap refresh memperpanjang masa berlaku.
# 7 hari nyaman untuk pengguna; 30 hari jika ingin sesi lebih awet.
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Cookie autentikasi ===
# None  -> otomatis: true di production, false di development
# true  -> paksa flag Secure (wajib untuk HTTPS dan SameSite=None)
COOKIE_SECURE=true
# auto  -> "lax" jika frontend & backend same-site, "none" jika beda site
# none  -> wajib HTTPS + COOKIE_SECURE=true
# Pilihan lain: lax | strict
COOKIE_SAMESITE=auto
# Kosongkan untuk host-only cookie (paling aman).
# Isi HANYA parent domain tanpa skema/port, contoh: .sobatlambung.id
COOKIE_DOMAIN=
# None -> otomatis aktif saat SameSite=None (cookie partitioned/CHIPS)
COOKIE_PARTITIONED=

# === Rate limiting per IP (slowapi) ===
# Set false saat load-test lokal.
RATE_LIMIT_ENABLED=true
# Set true HANYA jika di belakang reverse proxy/tunnel (ngrok, cloudflared,
# nginx, Render, Railway) agar rate limit dihitung per IP pengunjung.
TRUST_PROXY_HEADERS=true

# === Database (Supabase PostgreSQL) ===
DATABASE_URL=postgresql://user:password@host:port/dbname

# === WhatsApp Gateway (Fonnte) ===
FONNTE_TOKEN=isi_dengan_token_fonnte_anda
FONNTE_API_URL=https://api.fonnte.com/send

# === Admin Tools ===
# WAJIB diganti dengan kunci acak sebelum dipakai publik.
ADMIN_API_KEY=ganti_dengan_kunci_admin_anda

# === CORS ===
# WAJIB di production dan harus HTTPS.
# Same-origin (nginx proxy): cukup origin halaman frontend, contoh:
#   CORS_ORIGINS=https://sobatlambung.id
# Beda origin: daftar semua origin frontend, pisahkan dengan koma.
#   CORS_ORIGINS=https://sobatlambung.id,https://www.sobatlambung.id
CORS_ORIGINS=https://sobatlambung.id

# === Jadwal Pengingat Makan ===
# Jam pengingat TIDAK diatur lewat .env (sengaja, agar hanya ada satu sumber).
# Ubah langsung di: backend/app/reminder_config.py -> blok "PENGATURAN JAM".
