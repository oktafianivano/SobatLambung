# === Application ===
APP_ENV=development

# === Security / JWT ===
# Gunakan string acak panjang (minimal 32 karakter):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=isi_dengan_string_acak_panjang_minimal_32_karakter
ALGORITHM=HS256
# 720 menit = 12 jam. Cukup untuk satu hari pameran, tidak abadi.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Rate limiting per IP (slowapi). Set false saat load-test lokal.
RATE_LIMIT_ENABLED=true
# Set true HANYA jika di belakang reverse proxy/tunnel (ngrok, cloudflared)
# agar rate limit dihitung per IP pengunjung, bukan IP tunnel.
TRUST_PROXY_HEADERS=false

# === Database (Supabase PostgreSQL) ===
DATABASE_URL=postgresql://user:password@host:port/dbname

# === WhatsApp Gateway (Fonnte) ===
FONNTE_TOKEN=isi_dengan_token_fonnte_anda
FONNTE_API_URL=https://api.fonnte.com/send

# === Admin Tools ===
# WAJIB diganti dengan kunci acak sebelum dipakai publik.
ADMIN_API_KEY=ganti_dengan_kunci_admin_anda

# === CORS (pisahkan dengan koma) ===
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
