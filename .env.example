# =========================================================================
# Contoh konfigurasi Docker Compose (file ini dibaca oleh docker-compose.yml)
# Salin menjadi `.env` di root repo, lalu sesuaikan nilainya.
# Kredensial database/Fonnte tetap diletakkan di backend/.env.
# =========================================================================

# production | development
APP_ENV=production

# Cookie autentikasi
# - COOKIE_SECURE wajib true di production (HTTPS).
# - COOKIE_SAMESITE=auto  -> same-origin: lax, beda site: none + Secure
# - COOKIE_DOMAIN kosongkan untuk host-only cookie. Isi parent domain
#   (contoh: .sobatlambung.id) hanya bila frontend & API memakai subdomain
#   berbeda dan ingin cookie dibagikan.
COOKIE_SECURE=true
COOKIE_SAMESITE=auto
COOKIE_DOMAIN=

# Set true bila backend berada di belakang reverse proxy (nginx/Caddy/
# Cloudflare/Render/Railway) agar rate limit memakai IP asli pengunjung.
TRUST_PROXY_HEADERS=true

# Kosongkan untuk deployment same-origin (nginx mem-proxy /api -> backend).
# Isi hanya jika frontend memanggil backend di origin lain, contoh:
# VITE_API_URL=https://api.sobatlambung.id
VITE_API_URL=
