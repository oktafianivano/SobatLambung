# URL backend API (tanpa trailing slash).
#
# Kosongkan untuk:
# - development lokal: otomatis http://<host-halaman>:8000
# - production same-origin: request memakai origin halaman + /api/v1
#   (nginx image frontend sudah mem-proxy /api ke service backend)
#
# Isi hanya bila backend berada di origin lain, contoh:
# VITE_API_URL=https://api.sobatlambung.id
VITE_API_URL=
